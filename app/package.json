{
  "name": "tether-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:shell": "cargo build -p tether-daemon && vite",
    "build": "tsc --noEmit && vitest run && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "node scripts/stage-tetherd.mjs && tauri build --config src-tauri/tauri.bundle.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.12.5",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "motion": "^14.5.0",
    "prettier": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.3.1",
    "sql-formatter": "^15.10.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
