{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Tether's own commands (including its open-at-login setting), daemon events and matching the title bar to the theme. Nothing else: no file system, shell, HTTP or opener access, and nothing for remote pages.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",
    "allow-status",
    "allow-devices",
    "allow-history",
    "allow-pair",
    "allow-join",
    "allow-revoke",
    "allow-set-paused",
    "allow-set-pinned",
    "allow-rename-device",
    "allow-send-item",
    "allow-copy-here",
    "allow-palette-shortcut",
    "allow-scratchpad-shortcut",
    "allow-show-scratchpad",
    "allow-notes",
    "allow-note-create",
    "allow-note-open",
    "allow-note-edit",
    "allow-note-meta",
    "allow-note-history",
    "allow-note-at",
    "allow-note-restore",
    "allow-delete-item",
    "allow-open-link",
    "allow-autostart",
    "allow-set-autostart",
    "allow-notifications",
    "allow-set-notifications"
  ]
}
